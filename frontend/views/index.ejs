<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Kelayakan Ekspor Manggis</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-800 font-sans min-h-screen">

    <nav class="bg-green-700 text-white p-4 shadow-md">
        <div class="max-w-5xl mx-auto flex justify-between items-center">
            <h1 class="text-xl font-bold">Manggoes</h1>
            <span class="text-sm">Computer Vision - YOLOv8</span>
        </div>
    </nav>

    <main class="max-w-5xl mx-auto p-6 mt-8 grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h2 class="text-2xl font-bold mb-4 text-gray-700">Cek Kelayakan Manggis</h2>
            <p class="text-gray-500 mb-6 text-sm">Unggah foto buah manggis untuk dianalisis oleh AI (YOLOv8) apakah memenuhi standar ekspor atau tidak.</p>

            <% if (error) { %>
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4">
                    <span class="block sm:inline"><%= error %></span>
                </div>
            <% } %>

            <form action="/cek-kelayakan" method="POST" enctype="multipart/form-data">
                <div class="mb-4">
                    <label class="block text-gray-700 text-sm font-bold mb-2" for="image">
                        Pilih Gambar Manggis
                    </label>
                    <input class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring focus:border-green-300" 
                           id="image" type="file" name="image" accept="image/jpeg, image/png" required>
                </div>
                <button class="bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded w-full transition duration-300" type="submit">
                    Analisis Gambar
                </button>
            </form>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h2 class="text-2xl font-bold mb-4 text-gray-700">Hasil Analisis</h2>
            
            <% if (result && result.status === 'success') { %>
                
                <div class="mb-4">
                    <img src="<%= imagePath %>" alt="Manggis yang dianalisis" class="w-full h-64 object-cover rounded-md border border-gray-200">
                </div>

                <div class="bg-gray-100 p-4 rounded-md">
                    <h3 class="font-bold text-lg mb-2">Detail Deteksi:</h3>
                    <p class="text-sm mb-2">Jumlah objek terdeteksi: <strong><%= result.jumlah_manggis_terdeteksi %></strong></p>
                    
                    <% if (result.jumlah_manggis_terdeteksi === 0) { %>
                        <p class="text-red-600 font-semibold">Tidak ada manggis yang terdeteksi di dalam gambar ini.</p>
                    <% } else { %>
                        <ul class="space-y-2 mt-3">
                            <% result.data.forEach(function(item, index) { %>
                                <li class="p-3 bg-white border border-gray-200 rounded-md flex justify-between items-center shadow-sm">
                                    <span>
                                        Manggis #<%= index + 1 %>: 
                                        <span class="font-bold <%= item.kelayakan === 'Layak Ekspor' ? 'text-green-600' : 'text-red-600' %>">
                                            <%= item.kelayakan %>
                                        </span>
                                    </span>
                                    <span class="text-xs bg-blue-100 text-blue-800 py-1 px-2 rounded-full">
                                        Akurasi: <%= (item.confidence_score * 100).toFixed(0) %>%
                                    </span>
                                </li>
                            <% }); %>
                        </ul>
                    <% } %>
                </div>

            <% } else { %>
                <div class="flex items-center justify-center h-48 text-gray-400 border-2 border-dashed border-gray-300 rounded-md">
                    <p>Hasil analisis akan muncul di sini</p>
                </div>
            <% } %>
        </div>

    </main>

</body>
</html>