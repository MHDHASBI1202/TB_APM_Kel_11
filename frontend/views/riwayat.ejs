<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Riwayat Analisis — Manggoesteen</title>
  <meta name="description" content="Riwayat analisis kelayakan ekspor manggis menggunakan Manggoesteen AI.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <%- include('partials/base_styles') %>
  <style>
    .page-header { text-align: center; padding: 2.5rem 1.5rem 0; }
    .page-header h1 { font-size: clamp(1.6rem,3.5vw,2.4rem); font-weight: 900; color: var(--text); letter-spacing: -.5px; }
    .page-header h1 span { background: var(--grad-main); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .page-header p { color: var(--text-muted); font-size: .93rem; margin-top: .5rem; }

    /* ── Summary strip ── */
    .summary-strip {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 1rem; margin: 2rem 0;
    }
    .sum-card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 16px; padding: 1.35rem 1.25rem; text-align: center;
      box-shadow: var(--shadow-sm);
    }
    .sum-card .num { font-size: 2rem; font-weight: 900; background: var(--grad-main); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .sum-card .lbl { font-size: .73rem; color: var(--text-muted); font-weight: 600; margin-top: .2rem; }

    /* ── Filter bar ── */
    .filter-bar {
      display: flex; align-items: center; gap: .75rem; margin-bottom: 1.5rem; flex-wrap: wrap;
    }
    .filter-btn {
      padding: .45rem 1.1rem; border-radius: 999px; border: 1px solid var(--border);
      background: var(--surface); color: var(--text-muted); font-family: inherit;
      font-size: .8rem; font-weight: 600; cursor: pointer; transition: all .2s;
    }
    .filter-btn.active, .filter-btn:hover {
      background: var(--ok-bg); color: var(--purple); border-color: #c4b5fd;
    }
    .filter-search {
      margin-left: auto; position: relative;
    }
    .filter-search input {
      padding: .45rem 1rem .45rem 2.25rem; border: 1px solid var(--border);
      border-radius: 999px; font-family: inherit; font-size: .82rem;
      color: var(--text); background: var(--surface); outline: none;
      transition: border-color .2s; width: 200px;
    }
    .filter-search input:focus { border-color: var(--purple); }
    .filter-search::before { content: '🔍'; position: absolute; left: .75rem; top: 50%; transform: translateY(-50%); font-size: .75rem; }

    /* ── Table / List ── */
    .history-table { width: 100%; border-collapse: collapse; }
    .history-table thead th {
      background: var(--surface2); padding: .75rem 1rem;
      text-align: left; font-size: .75rem; font-weight: 700;
      color: var(--text-muted); letter-spacing: .5px; text-transform: uppercase;
      border-bottom: 1px solid var(--border);
    }
    .history-table thead th:first-child { border-radius: 10px 0 0 10px; }
    .history-table thead th:last-child { border-radius: 0 10px 10px 0; text-align: center; }
    .history-table tbody tr {
      border-bottom: 1px solid var(--border);
      transition: background .15s; cursor: pointer;
    }
    .history-table tbody tr:hover { background: var(--bg-soft); }
    .history-table tbody td { padding: .9rem 1rem; font-size: .875rem; vertical-align: middle; }
    .history-table tbody td:last-child { text-align: center; }
    .thumb {
      width: 56px; height: 44px; border-radius: 8px; object-fit: cover;
      border: 1px solid var(--border); background: var(--surface2);
      display: flex; align-items: center; justify-content: center; font-size: 1.4rem;
    }
    .th-date { font-size: .78rem; color: var(--text-muted); }
    .th-count { font-weight: 700; color: var(--purple); }
    .action-btn {
      padding: .35rem .9rem; border-radius: 8px; border: 1px solid #d8b4fe;
      background: var(--ok-bg); color: var(--purple); font-size: .75rem;
      font-weight: 700; cursor: pointer; font-family: inherit; transition: all .2s;
    }
    .action-btn:hover { background: var(--purple); color: #fff; }

    /* ── Empty state ── */
    .empty-state {
      text-align: center; padding: 5rem 1rem;
      border: 2px dashed #e9d5ff; border-radius: 16px;
      background: var(--bg-soft); color: var(--text-muted);
    }
    .empty-state .icon { font-size: 4rem; margin-bottom: 1rem; }
    .empty-state h3 { font-size: 1.1rem; font-weight: 700; color: var(--text); margin-bottom: .5rem; }
    .empty-state p { font-size: .875rem; line-height: 1.6; max-width: 360px; margin: 0 auto; }

    /* ── Pagination ── */
    .pagination { display: flex; justify-content: center; gap: .4rem; margin-top: 1.5rem; }
    .page-btn {
      width: 36px; height: 36px; border-radius: 9px; border: 1px solid var(--border);
      background: var(--surface); display: flex; align-items: center; justify-content: center;
      font-size: .82rem; font-weight: 600; cursor: pointer; color: var(--text-muted); transition: all .2s;
    }
    .page-btn.active, .page-btn:hover { background: var(--purple); color: #fff; border-color: var(--purple); }

    /* ── Responsive table ── */
    @media(max-width:640px){
      .history-table thead { display: none; }
      .history-table tbody tr { display: grid; grid-template-columns: 56px 1fr auto; gap: .5rem 1rem; padding: .75rem 0; align-items: center; }
      .history-table tbody td { padding: 0; border: none; }
      .history-table tbody td[data-label="Tanggal"] { grid-column: 2; font-size: .78rem; color: var(--text-muted); }
      .history-table tbody td[data-label="Terdeteksi"],
      .history-table tbody td[data-label="Layak"],
      .history-table tbody td[data-label="Tidak"] { display: none; }
      .history-table tbody td[data-label="Aksi"] { grid-row: 1; grid-column: 3; }
    }
  </style>
</head>
<body>

<%- include('partials/navbar', { activeNav: 'riwayat' }) %>

<main>
  <div class="page-header animate-up">
    <h1>Riwayat <span>Analisis</span></h1>
    <p>Semua analisis yang pernah dilakukan tersimpan di sini</p>
  </div>

  <%
    const totalAnalisis = history ? history.length : 0;
    const totalDeteksi  = history ? history.reduce((s,h) => s + (h.jumlah||0), 0) : 0;
    const totalLayak    = history ? history.reduce((s,h) => s + (h.layak||0), 0) : 0;
    const totalTidak    = totalDeteksi - totalLayak;
  %>

  <div class="summary-strip">
    <div class="sum-card animate-up delay-1">
      <div class="num"><%= totalAnalisis %></div>
      <div class="lbl">Total Analisis</div>
    </div>
    <div class="sum-card animate-up delay-2">
      <div class="num"><%= totalDeteksi %></div>
      <div class="lbl">Manggis Terdeteksi</div>
    </div>
    <div class="sum-card animate-up delay-3">
      <div class="num" style="background:linear-gradient(135deg,#5b21b6,#7c3aed);-webkit-background-clip:text;"><%= totalLayak %></div>
      <div class="lbl">Layak Ekspor</div>
    </div>
    <div class="sum-card animate-up delay-4">
      <div class="num" style="background:linear-gradient(135deg,#dc2626,#ef4444);-webkit-background-clip:text;"><%= totalTidak %></div>
      <div class="lbl">Tidak Layak</div>
    </div>
  </div>

  <div class="card animate-up delay-2">
    <% if (!history || history.length === 0) { %>
      <div class="empty-state">
        <div class="icon">📋</div>
        <h3>Belum ada riwayat analisis</h3>
        <p>Mulai analisis gambar manggis pertama Anda untuk melihat riwayat di sini.</p>
        <a href="/analisis" class="btn btn-primary" style="margin-top:1.5rem;display:inline-flex;">🔍 Mulai Analisis</a>
      </div>
    <% } else { %>
      <div class="filter-bar">
        <button class="filter-btn active" id="filter-all" onclick="filterHistory('all')">Semua</button>
        <button class="filter-btn" id="filter-layak" onclick="filterHistory('layak')">✅ Ada Layak</button>
        <button class="filter-btn" id="filter-tidak" onclick="filterHistory('tidak')">❌ Ada Tidak Layak</button>
        <div class="filter-search">
          <input type="text" id="search-input" placeholder="Cari..." oninput="searchHistory(this.value)">
        </div>
      </div>
      <div style="overflow-x:auto;">
        <table class="history-table" id="history-table">
          <thead>
            <tr>
              <th>Gambar</th>
              <th>Tanggal &amp; Waktu</th>
              <th>Terdeteksi</th>
              <th>Layak</th>
              <th>Tidak Layak</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody id="history-body">
            <% history.forEach(function(h, i) { %>
            <tr data-layak="<%= h.layak||0 %>" data-tidak="<%= (h.jumlah||0)-(h.layak||0) %>" data-date="<%= h.tanggal||'' %>">
              <td data-label="Gambar">
                <% if(h.imagePath){ %>
                  <img src="<%= h.imagePath %>" alt="thumb" class="thumb" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
                  <div class="thumb" style="display:none;">🍇</div>
                <% } else { %>
                  <div class="thumb">🍇</div>
                <% } %>
              </td>
              <td data-label="Tanggal">
                <div style="font-weight:600;color:var(--text);">
                  <%= h.tanggal ? new Date(h.tanggal).toLocaleDateString('id-ID',{day:'2-digit',month:'long',year:'numeric'}) : '-' %>
                </div>
                <div class="th-date">
                  <%= h.tanggal ? new Date(h.tanggal).toLocaleTimeString('id-ID',{hour:'2-digit',minute:'2-digit'}) : '' %>
                </div>
              </td>
              <td data-label="Terdeteksi"><span class="th-count"><%= h.jumlah||0 %></span> manggis</td>
              <td data-label="Layak"><span class="badge layak"><%= h.layak||0 %> Layak</span></td>
              <td data-label="Tidak"><span class="badge tidak"><%= (h.jumlah||0)-(h.layak||0) %> Tidak</span></td>
              <td data-label="Aksi">
                <% if(h.imagePath){ %>
                  <a href="/analisis" class="action-btn">Lihat</a>
                <% } else { %>
                  <button class="action-btn" disabled style="opacity:.4;cursor:default;">–</button>
                <% } %>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <% if(!history || history.length === 0) { %>
  <% } %>

</main>

<footer>
  <strong style="color:var(--purple-dk);">Manggoesteen</strong> &nbsp;·&nbsp;
  Dibuat oleh <span>Kelompok 11</span> &nbsp;·&nbsp;
  APM Universitas Andalas &nbsp;·&nbsp;
  YOLOv8 Computer Vision
</footer>

<script>
function toggleMobileNav(){ document.getElementById('navMobile').classList.toggle('open'); }

function filterHistory(type){
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('filter-'+type).classList.add('active');
  const rows = document.querySelectorAll('#history-body tr');
  rows.forEach(r => {
    const layak = parseInt(r.dataset.layak)||0;
    const tidak = parseInt(r.dataset.tidak)||0;
    if(type==='all') r.style.display='';
    else if(type==='layak') r.style.display = layak>0 ? '' : 'none';
    else if(type==='tidak') r.style.display = tidak>0 ? '' : 'none';
  });
}

function searchHistory(q){
  const rows = document.querySelectorAll('#history-body tr');
  rows.forEach(r => {
    r.style.display = r.textContent.toLowerCase().includes(q.toLowerCase()) ? '' : 'none';
  });
}
</script>
</body>
</html>
